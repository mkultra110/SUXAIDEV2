# SUXAI client — Vite environment variables
# Copy to .env.local and fill in the values for local development.
# These variables are embedded in the Electron bundle at build time.

# Base URL of the SUXAI VPS backend (no trailing slash).
# Default (if omitted): https://suxai.209-99-186-238.sslip.io
VITE_API_BASE_URL=https://your-vps-domain.example.com

# Full URL to the auto-update manifest JSON served by the VPS backend.
# Default (if omitted): https://suxai.209-99-186-238.sslip.io/update/manifest
VITE_UPDATE_MANIFEST_URL=https://your-vps-domain.example.com/update/manifest
