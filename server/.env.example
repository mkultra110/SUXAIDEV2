# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- CORS ---
# Comma-separated list of allowed origins, or "*" to allow Electron (no origin).
CORS_ORIGINS=*

# --- Auth ---
# Generate 64-byte random: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Path to the user data directory (must be writable).
# Production (isolated under /opt/suxai/): DATA_DIR=/opt/suxai/data
DATA_DIR=./data

# --- Quatarly (AI proxy) ---
# Your Quatarly key. NEVER expose to clients — the proxy uses it server-side only.
QUATARLY_API_KEY=
QUATARLY_BASE_URL=https://api.quatarly.cloud

# --- Update manifest ---
# The JSON returned by GET /update/manifest
UPDATE_VERSION=0.1.0
UPDATE_URL=https://downloads.suxai.example/SUXAI-Setup-0.1.0.exe
UPDATE_NOTES=Initial release
UPDATE_SHA256=
UPDATE_SIZE=
