{
  "name": "suxai-dev",
  "productName": "SUXAI",
  "version": "0.1.0",
  "description": "SUXAI — a premium AI-powered desktop IDE",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
