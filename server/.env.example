# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. NEVER use "*" in production.
# Example: https://suxai.209-99-186-238.sslip.io,app://suxai
CORS_ORIGINS=https://suxai.209-99-186-238.sslip.io

# ── Auth ──────────────────────────────────────────────────────────────────────
# Auto-generated by install.sh (64 random bytes hex). DO NOT set manually
# unless rotating — regenerating invalidates all active sessions.
JWT_SECRET=<64-byte-random-hex>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ── Data ──────────────────────────────────────────────────────────────────────
DATA_DIR=/opt/suxai/data

# ── Quatarly AI proxy ─────────────────────────────────────────────────────────
# Required. Rotate via Quatarly dashboard; never commit to git.
QUATARLY_API_KEY=qua-...
QUATARLY_BASE_URL=https://api.quatarly.cloud

# ── Free-tier quota ───────────────────────────────────────────────────────────
# Cumulative AI streaming time per UTC day (ms). Default: 30 min = 1800000.
# Set to 0 to disable the free tier entirely (pro-only server).
FREE_DAILY_LIMIT_MS=1800000

# ── Auto-updater ──────────────────────────────────────────────────────────────
# Served at GET /update/manifest. Bump UPDATE_VERSION after uploading a new
# installer to /opt/suxai/releases/ and update UPDATE_URL accordingly.
UPDATE_VERSION=0.1.0
UPDATE_URL=https://suxai.209-99-186-238.sslip.io/releases/suxai-setup-0.1.0.exe
UPDATE_NOTES=Initial release
UPDATE_SHA256=
UPDATE_SIZE=0
